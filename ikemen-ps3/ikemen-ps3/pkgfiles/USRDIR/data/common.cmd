; common.cmd - commands available to every character (added before the character's own CMD file).
; Same name as one in a character's CMD = either one counts. Edit freely; no rebuild needed.
[Defaults]
command.time = 15
command.buffer.time = 1

[Command]
name = "holdfwd"
command = /$F

[Command]
name = "holdback"
command = /$B

[Command]
name = "holdup"
command = /$U

[Command]
name = "holddown"
command = /$D
